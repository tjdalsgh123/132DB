{
  // Cloudflare Workers 정적 사이트 설정 (132총국 웹앱 · React + Vite)
  // 배포할 때 먼저 빌드(npm ci && npm run build)해서 dist/ 를 올림
  // 운영: npx wrangler deploy            → 132db      (main 브랜치)
  // 개발: npx wrangler deploy --env dev  → 132db-dev  (dev 브랜치)
  "name": "132db",
  "compatibility_date": "2026-10-01",
  "build": { "command": "npm ci && npm run build" },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "env": {
    "dev": {
      "name": "132db-dev",
      "build": { "command": "npm ci && npm run build" },
      "assets": {
        "directory": "./dist",
        "not_found_handling": "single-page-application"
      }
    }
  }
}
